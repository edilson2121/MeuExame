generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================
enum Role {
  USER
  ADMIN
  TEACHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionPlan {
  BASIC // ← ADICIONAR ESTE
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY // M-Pesa, Airtel Money, etc
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  OTHER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String
  name          String
  phone         String?
  role          Role         @default(USER)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  // Content Relations
  contents  Content[]
  exercises Exercise[]
  exams     Exam[]
  results   Result[]
  pages     Page[]

  // Subscription/Payment Relations
  subscription Subscription?
  payments     PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Institution {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  logo        String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String? @default("Moçambique")

  // Relations
  users    User[]
  courses  Course[]
  subjects Subject[]
  exams    Exam[]
  pages    InstitutionPage[]

  // Payment tracking
  isPaid Boolean   @default(false)
  paidAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutions")
}

model Content {
  id        String     @id @default(cuid())
  title     String
  body      String
  subjectId String?
  userId    String
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id])
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("contents")
}

model Exercise {
  id        String     @id @default(cuid())
  title     String
  body      String
  subjectId String?
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  contentId String
  content   Content    @relation(fields: [contentId], references: [id])
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("exercises")
}

model Exam {
  id              String         @id @default(cuid())
  title           String
  body            String?        @db.Text
  description     String?        @db.Text
  instructions    String?        @db.Text
  durationMinutes Int?
  imageUrl        String?
  status          PublishStatus  @default(DRAFT)
  publishedAt     DateTime?
  isPaidRequired  Boolean        @default(true)
  institutionId   String?
  institution     Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  subjectId       String?
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  questions       ExamQuestion[]
  results         Result[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("exams")
}

model Course {
  id            String       @id @default(cuid())
  name          String
  description   String?
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  subjects      Subject[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("courses")
}

model Subject {
  id            String       @id @default(cuid())
  name          String
  description   String?
  courseId      String?
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  contents      Content[]
  exercises     Exercise[]
  exams         Exam[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("subjects")
}

model Question {
  id            String   @id @default(cuid())
  text          String
  options       Json?
  correctAnswer String?
  explanation   String?  @db.Text
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("questions")
}

model ExamQuestion {
  id        String       @id @default(cuid())
  text      String       @db.Text
  imageUrl  String?
  points    Float        @default(1)
  sortOrder Int          @default(0)
  examId    String
  exam      Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options   ExamOption[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("exam_questions")
}

model ExamOption {
  id          String       @id @default(cuid())
  label       String
  text        String       @db.Text
  imageUrl    String?
  isCorrect   Boolean      @default(false)
  explanation String?      @db.Text
  sortOrder   Int          @default(0)
  questionId  String
  question    ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("exam_options")
}

model Result {
  id             String   @id @default(cuid())
  score          Float
  totalQuestions Int      @default(0)
  correctAnswers Int      @default(0)
  percentage     Float    @default(0)
  answers        Json?
  completedAt    DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("results")
}

// ============================================================
// MODEL: PAGE - Páginas dinâmicas
// ============================================================
model Page {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        @db.Text
  description String?
  keywords    String?
  template    String?       @default("default")
  showInMenu  Boolean       @default(false)
  menuOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  user        User          @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sections PageSection[]

  @@map("pages")
}

// ============================================================
// MODEL: PAGE_SECTION - Seções das páginas
// ============================================================
model PageSection {
  id        String   @id @default(cuid())
  type      String
  title     String?
  content   String?  @db.Text
  imageUrl  String?
  imageAlt  String?
  settings  Json?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  pageId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id])

  @@map("page_sections")
}

// ============================================================
// MODEL: LAYOUT_TEMPLATE - Templates de layouts reutilizáveis
// ============================================================
model LayoutTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  html        String   @db.Text
  css         String?  @db.Text
  thumbnail   String?
  config      Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages InstitutionPage[]

  @@map("layout_templates")
}

// ============================================================
// MODEL: INSTITUTION_PAGE - Páginas de instituições gerenciadas por admin
// ============================================================
model InstitutionPage {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String? @db.Text
  content     String? @db.Text

  layoutId String
  layout   LayoutTemplate @relation(fields: [layoutId], references: [id])

  settings Json? // Configurações customizadas do layout

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  showInMenu  Boolean @default(false)
  menuOrder   Int     @default(0)
  seoTitle    String?
  seoKeywords String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, slug])
  @@map("institution_pages")
}

// ============================================================
// MODEL: SUBSCRIPTION - Assinatura/Pagamento do usuário
// ============================================================
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(BASIC)
  status SubscriptionStatus @default(INACTIVE)

  startDate DateTime?
  endDate   DateTime?

  amount   Float
  currency String @default("MZN") // Metical

  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments PaymentTransaction[]

  @@map("subscriptions")
}

// ============================================================
// MODEL: PAYMENT_TRANSACTION - Histórico de pagamentos
// ============================================================
model PaymentTransaction {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Float
  currency String        @default("MZN")
  status   PaymentStatus @default(PENDING)

  method    PaymentMethod
  reference String? // Referência de pagamento (celular, banco, etc)

  approvedBy String? // ID do admin que aproveu
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_transactions")
}
