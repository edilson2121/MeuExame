generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String
  name          String
  role          Role         @default(USER)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  contents      Content[]
  exercises     Exercise[]
  exams         Exam[]
  results       Result[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users")
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logo        String?
  users       User[]
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("institutions")
}

model Course {
  id            String      @id @default(cuid())
  name          String
  description   String?
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  subjects      Subject[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("courses")
}

model Subject {
  id          String     @id @default(cuid())
  name        String
  description String?
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id])
  contents    Content[]
  exercises   Exercise[]
  exams       Exam[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("subjects")
}

model Content {
  id          String      @id @default(cuid())
  title       String
  description String?
  content     String
  type        ContentType @default(TEXT)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id])
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  views       Int         @default(0)
  likes       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("contents")
}

model Exercise {
  id          String     @id @default(cuid())
  title       String
  description String?
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id])
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  difficulty  Difficulty @default(MEDIUM)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("exercises")
}

model Question {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       String[]
  correctAnswer String
  explanation   String?
  exerciseId    String
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("questions")
}

model Exam {
  id          String    @id @default(cuid())
  title       String
  description String?
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  duration    Int // in minutes
  startDate   DateTime?
  endDate     DateTime?
  results     Result[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("exams")
}

model Result {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  score       Float
  total       Float
  percentage  Float
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("results")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ContentType {
  TEXT
  VIDEO
  PDF
  AUDIO
  LINK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
  FILL_IN_BLANK
}
