# ===========================================
# MEUEXAME - CONFIGURAÇÃO DO BACKEND
# ===========================================

NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meuexame

# JWT
JWT_SECRET=meuexame-super-secret-key-2024-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis (opcional)
REDIS_URL=redis://localhost:6379

# ===========================================
# GOOGLE OAUTH - LOGIN COM GOOGLE
# ===========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ===========================================
# M-PESA - PAGAMENTOS
# ===========================================
MPESA_SHORTCODE=your_shortcode
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=http://localhost:3001/api/wallet/webhooks/mpesa
MPESA_ENV=sandbox

# ===========================================
# E-MOLA - PAGAMENTOS
# ===========================================
EMOLA_API_KEY=your_emola_api_key
EMOLA_CALLBACK_URL=http://localhost:3001/api/wallet/webhooks/emola

# ===========================================
# DEBITPAY - PAGAMENTOS
# ===========================================
DEBITPAY_API_KEY=your_debitpay_api_key
DEBITPAY_CALLBACK_URL=http://localhost:3001/api/wallet/webhooks/debitpay

# ===========================================
# DÉBITO PAY (alternativo)
# ===========================================
DEBITO_SECRET_KEY=your_debito_secret_key
DEBITO_WALLET_CODE=your_mpesa_wallet_code
DEBITO_WALLET_CODE_EMOLA=your_emola_wallet_code
DEBITO_MERCHANT_ID=your_merchant_id
DEBITO_API_URL=https://api.debito.co.mz
