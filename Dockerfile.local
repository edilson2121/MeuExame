# Estágio 1: Build
FROM node:20-alpine AS builder

# Instalar OpenSSL, Python e ferramentas de build
RUN apk add --no-cache openssl python3 py3-pip make g++

WORKDIR /app

# Copiar arquivos de configuração primeiro (para cache)
COPY package*.json ./
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/

# Instalar dependências
RUN npm install concurrently --save-dev
RUN cd backend && npm install prisma@5.22.0 @prisma/client@5.22.0 --save-dev || true
RUN cd frontend && npm install || true

# Copiar código fonte
COPY . .

# Gerar Prisma client
RUN cd backend && npx prisma@5.22.0 generate || true

# Build do backend
RUN cd backend && npm run build || true

# Build do frontend
RUN cd frontend && npm run build || true

# Estágio 2: Produção
FROM node:20-alpine

# Instalar OpenSSL na produção
RUN apk add --no-cache openssl

WORKDIR /app

# Copiar dependências e código buildado
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
# Copiar arquivos de configuração TypeScript
COPY --from=builder /app/tsconfig.json ./
COPY --from=builder /app/backend/tsconfig.json ./backend/
COPY --from=builder /app/backend/tsconfig.build.json ./backend/
# Copiar backend
COPY --from=builder /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/backend/prisma ./backend/prisma

# Copiar frontend
COPY --from=builder /app/frontend ./frontend

EXPOSE 3000 3001 5555

CMD ["npm", "start"]
