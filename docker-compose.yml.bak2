services:
  postgres:
    image: postgres:15-alpine
    container_name: meuexame-postgres
    environment:
      POSTGRES_USER: ${DB_USER:-meuexame}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-meuexame123}
      POSTGRES_DB: ${DB_NAME:-meuexame}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-meuexame}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - meuexame-network
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: meuexame-redis
    ports:
      - "${REDIS_PORT:-6379}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - meuexame-network
    restart: unless-stopped

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: meuexame-backend
    environment:
      NODE_ENV: ${NODE_ENV:-development}
      DATABASE_URL: postgresql://${DB_USER:-meuexame}:${DB_PASSWORD:-meuexame123}@postgres:5432/${DB_NAME:-meuexame}
      REDIS_URL: redis://redis:6379
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
      API_PORT: 3001
      API_HOST: 0.0.0.0
    ports:
      - "${BACKEND_PORT:-3001}:3001"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - ./backend/src:/app/src
      - ./backend/prisma:/app/prisma
      - ./uploads:/app/uploads
      - /app/node_modules
    networks:
      - meuexame-network
    restart: unless-stopped
    command: npm run start:dev

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: meuexame-frontend
    environment:
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://backend:3001}
      NODE_ENV: ${NODE_ENV:-development}
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    depends_on:
      - backend
    volumes:
      - ./frontend/src:/app/src
      - ./frontend/public:/app/public
      - /app/.next
      - /app/node_modules
    networks:
      - meuexame-network
    restart: unless-stopped
    command: npm run dev

  # nginx:
  #   image: nginx:alpine
  #   container_name: meuexame-nginx
  #   ports:
  #     - "80:80"
  #     - "443:443"
  #   volumes:
  #     - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
  #     - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
  #   depends_on:
  #     - backend
  #     - frontend
  #   networks:
  #     - meuexame-network
  #   restart: unless-stopped

volumes:
  postgres_data:

networks:
  meuexame-network:
    driver: bridge

