# ===========================================
# MeuExame - Configuração de Produção
# ===========================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
POSTGRES_USER=meuexame
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=meuexame

# Redis Configuration
REDIS_URL=redis://redis:6379

# API Configuration
API_URL=https://your-domain.com
APP_URL=https://your-domain.com

# CORS - Allowed origins (comma separated)
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Email Configuration (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===========================================
# DÉBITO PAY - Gateway de Pagamentos
# Documentação: https://docs.debitpay.co.mz
# ===========================================

# URL da API (Supabase Edge Function)
DEBITO_API_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1

# Chave secreta da API (fornecida pela DébitO Pay)
DEBITO_SECRET_KEY=your-debito-secret-key

# Wallet ID para M-Pesa (código shortcode fornecido pela DébitO Pay)
# Exemplo: 15156
DEBITO_WALLET_CODE=15156

# Wallet ID para e-Mola (fornecido pela DébitO Pay)
# Exemplo: 61526
DEBITO_WALLET_CODE_EMOLA=61526

# Merchant ID da DébitO Pay
DEBITO_MERCHANT_ID=your-merchant-id

# URL de callback para notificações de pagamento
# Configure esta URL na plataforma DébitO Pay
DEBITO_CALLBACK_URL=https://your-domain.com/api/wallet/webhooks/debito
