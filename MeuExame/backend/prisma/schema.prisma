generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
  TEACHER
}

enum MaterialType {
  MANUAL
  EXAM
}

enum AccessLevel {
  FREE
  PAID
  BLOCKED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
  FILL_IN_BLANK
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  OTHER
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ============================================================
// MODEL: USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          Role      @default(USER)
  institutionId String?
  
  // Relations
  institution   Institution?     @relation(fields: [institutionId], references: [id])
  materials     EducationalMaterial[] @relation("UserMaterials")
  results       Result[]
  subscriptions Subscription?
  payments      PaymentTransaction[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// ============================================================
// MODEL: INSTITUTION
// ============================================================

model Institution {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?   @db.Text
  logo        String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?   @default("Moçambique")
  
  // Payment tracking
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  
  // Relations
  users       User[]
  subjects    Subject[]
  materials   EducationalMaterial[]
  pages       InstitutionPage[]
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("institutions")
}

// ============================================================
// MODEL: SUBJECT (Disciplina)
// ============================================================

model Subject {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  // Relations
  materials   EducationalMaterial[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("subjects")
}

// ============================================================
// MODEL: EDUCATIONAL_MATERIAL (Manual/Exame)
// ============================================================

model EducationalMaterial {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  content       String?       @db.Text
  type          MaterialType  @default(MANUAL)
  accessLevel   AccessLevel   @default(FREE)
  
  // Relations
  subjectId     String
  subject       Subject       @relation(fields: [subjectId], references: [id])
  
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  
  createdBy     String
  creator       User          @relation("UserMaterials", fields: [createdBy], references: [id])
  
  // Exam specific
  duration      Int?          // Tempo em minutos
  passingScore  Float?        @default(60) // Nota mínima % para aprovação
  totalQuestions Int?         @default(0)
  
  // Status
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?
  isActive      Boolean       @default(true)
  
  // Block control
  blockedBy     String?
  blockedAt     DateTime?
  blockReason   String?       @db.Text
  
  // Relations
  questions     Question[]
  results       Result[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("educational_materials")
}

// ============================================================
// MODEL: QUESTION
// ============================================================

model Question {
  id            String        @id @default(cuid())
  text          String        @db.Text
  type          QuestionType  @default(MULTIPLE_CHOICE)
  options       Json?         // Array de opções
  correctAnswer String
  explanation   String?       @db.Text
  
  materialId    String
  material      EducationalMaterial @relation(fields: [materialId], references: [id])
  
  order         Int           @default(0)
  points        Float         @default(1)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("questions")
}

// ============================================================
// MODEL: RESULT
// ============================================================

model Result {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  materialId    String
  material      EducationalMaterial @relation(fields: [materialId], references: [id])
  
  score         Float     // Total de acertos
  total         Float     // Total de questões
  percentage    Float     // Percentual de acertos
  correctAnswers Int
  wrongAnswers  Int
  
  answers       Json?     // Respostas do usuário
  
  startedAt     DateTime  @default(now())
  completedAt   DateTime  @default(now())
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("results")
}

// ============================================================
// MODEL: INSTITUTION_PAGE (Página da Instituição)
// ============================================================

model InstitutionPage {
  id          String        @id @default(cuid())
  institutionId String
  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  title       String
  slug        String
  description String?       @db.Text
  content     String?       @db.Text
  
  layoutId    String
  settings    Json?
  
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  
  showInMenu  Boolean       @default(false)
  menuOrder   Int           @default(0)
  
  seoTitle    String?
  seoKeywords String?
  
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([institutionId, slug])
  @@map("institution_pages")
}

// ============================================================
// MODEL: SUBSCRIPTION
// ============================================================

model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan        SubscriptionPlan @default(BASIC)
  status      SubscriptionStatus @default(INACTIVE)
  
  startDate   DateTime?
  endDate     DateTime?
  
  amount      Float
  currency    String    @default("MZN")
  
  isActive    Boolean   @default(false)
  
  payments    PaymentTransaction[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("subscriptions")
}

// ============================================================
// MODEL: PAYMENT_TRANSACTION
// ============================================================

model PaymentTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subscriptionId String
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  amount        Float
  currency      String    @default("MZN")
  status        PaymentStatus @default(PENDING)
  
  method        PaymentMethod
  reference     String?   // Referência do pagamento
  
  approvedBy    String?
  approvedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payment_transactions")
}
